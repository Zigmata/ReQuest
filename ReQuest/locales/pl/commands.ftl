## Slash command descriptions and context menu names
## Used by FluentTranslator for Discord's built-in command localization

# Slash command descriptions
cmd-desc-ping = Wyślij szybkie zapytanie do bota, aby sprawdzić, czy jest online.
cmd-desc-invite = Wyświetla zaproszenie do dodania ReQuesta na Twój serwer.
cmd-desc-support = Wyświetla wersję bota i link do serwera deweloperskiego.
cmd-desc-language = Ustaw preferowany język odpowiedzi bota.
cmd-desc-help = Wyświetla listę komend i ich funkcji.
cmd-desc-admin = Kreator administracji. Tylko właściciel bota
cmd-desc-config = Menu konfiguracji serwera (tylko administratorzy serwera)
cmd-desc-gm = Menu Mistrza Gry
cmd-desc-player = Menu gracza
cmd-desc-shop = Otwiera sklep w bieżącym kanale, jeśli jest skonfigurowany.

# Context menu names
cmd-context-name-trade = Wymiana
cmd-context-name-modify-player = Modyfikuj Gracza
cmd-context-name-view-player = Podgląd Gracza
