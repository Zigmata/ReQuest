## Slash command descriptions and context menu names
## Used by FluentTranslator for Discord's built-in command localization

# Slash command descriptions
cmd-desc-ping = Få ett snabbt svar från boten för att se om den är online.
cmd-desc-invite = Visar en inbjudan för att lägga till ReQuest på din server.
cmd-desc-support = Visar botversionen och en länk till utvecklingsservern.
cmd-desc-language = Ställ in ditt önskade språk för botsvar.
cmd-desc-help = Visar en lista över kommandon och deras funktioner.
cmd-desc-admin = Administrationsguide. Endast botägare
cmd-desc-config = Serverkonfigurationsmenyer (Endast serveradministratörer)
cmd-desc-gm = GM-menyer
cmd-desc-player = Spelarmenyer
cmd-desc-shop = Öppnar en butik i den aktuella kanalen om en är konfigurerad.

# Context menu names
cmd-context-name-trade = Byt
cmd-context-name-modify-player = Ändra spelare
cmd-context-name-view-player = Visa spelare
