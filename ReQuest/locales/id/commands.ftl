## Slash command descriptions and context menu names
## Used by FluentTranslator for Discord's built-in command localization

# Slash command descriptions
cmd-desc-ping = Dapatkan balasan cepat dari bot untuk melihat apakah bot sedang online.
cmd-desc-invite = Menampilkan undangan untuk menambahkan ReQuest ke server Anda.
cmd-desc-support = Menampilkan versi bot dan tautan ke server pengembangan.
cmd-desc-language = Atur bahasa pilihan Anda untuk respons bot.
cmd-desc-help = Menampilkan daftar perintah beserta fungsinya.
cmd-desc-admin = Wizard administrasi. Khusus pemilik bot
cmd-desc-config = Menu Konfigurasi Server (khusus Admin Server)
cmd-desc-gm = Menu GM
cmd-desc-player = Menu Pemain
cmd-desc-shop = Membuka toko di kanal saat ini jika sudah dikonfigurasi.

# Context menu names
cmd-context-name-trade = Tukar
cmd-context-name-modify-player = Modifikasi Pemain
cmd-context-name-view-player = Lihat Pemain
