## Slash command descriptions and context menu names
## Used by FluentTranslator for Discord's built-in command localization

# Slash command descriptions
cmd-desc-ping = Získejte rychlou odpověď od bota, abyste zjistili, zda je online.
cmd-desc-invite = Zobrazí pozvánku pro přidání ReQuestu na váš server.
cmd-desc-support = Zobrazí verzi bota a odkaz na vývojový server.
cmd-desc-language = Nastavte preferovaný jazyk pro odpovědi bota.
cmd-desc-help = Zobrazí seznam příkazů a jejich funkcí.
cmd-desc-admin = Průvodce administrací. Pouze pro vlastníka bota
cmd-desc-config = Menu konfigurace serveru (pouze pro administrátory serveru)
cmd-desc-gm = Menu Game Mastera
cmd-desc-player = Menu hráče
cmd-desc-shop = Otevře obchod v aktuálním kanálu, pokud je nakonfigurován.

# Context menu names
cmd-context-name-trade = Obchod
cmd-context-name-modify-player = Upravit hráče
cmd-context-name-view-player = Zobrazit hráče
