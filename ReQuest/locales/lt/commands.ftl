cmd-desc-config = Serverio konfigūracijos meniu (tik serverio administratoriams)
cmd-desc-gm = GM meniu
cmd-desc-player = Žaidėjo meniu
cmd-desc-shop = Atidaro parduotuvę dabartiniame kanale, jei tokia sukonfigūruota.

